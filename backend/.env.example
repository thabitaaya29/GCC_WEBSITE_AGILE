# Copy to .env on your own trusted laptop. Never commit .env.
SUPABASE_URL=https://your-project-ref.supabase.co
# Public frontend access; the database grants and RLS still enforce read-only use.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_locally
# Trusted maintainer command ONLY. Never put this in VITE_* or a shared screenshot.
SUPABASE_SECRET_KEY=sb_secret_replace_locally

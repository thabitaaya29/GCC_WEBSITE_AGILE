{
  "name": "gcc-homepage-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "test": "node --test --test-concurrency=1 *.test.ts",
    "check": "tsc --noEmit",
